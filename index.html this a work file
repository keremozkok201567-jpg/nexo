/* Aramalar */
function media(v){return navigator.mediaDevices&&navigator.mediaDevices.getUserMedia?navigator.mediaDevices.getUserMedia({audio:true,video:v}):Promise.reject()}
function callUI(s,n,t){$("call").classList.toggle("hide",!s);$("cn").textContent=n||"";$("cs").textContent=t||"";var v=!!(lstream&&lstream.getVideoTracks().length);$("lv").classList.toggle("hide",!v);$("cm").classList.toggle("hide",!v)}
function endCall(){clearTimeout(ringT);var c=call;call=null;callOK=false;if(c){try{c.close()}catch(e){}}if(lstream){lstream.getTracks().forEach(function(t){t.stop()});lstream=null}$("call").classList.add("hide");$("rv").srcObject=null;$("lv").srcObject=null}
function bind(c,nm){
 c.on("stream",function(rs){callOK=true;clearTimeout(ringT);$("rv").srcObject=rs;callUI(true,nm,"Görüşme sürüyor")});
 c.on("close",function(){if(call!==c)return;var was=callOK,out=c.__out;endCall();if(!was&&out)alert(nm+" aramayı cevaplamadı veya reddetti.")});
 c.on("error",function(){if(call===c)endCall()})}
function startCall(v){
 if(!cur||call||!peer)return;var u=cur.un,nm=ct[u].name;
 media(v).then(function(st){
  lstream=st;callOK=false;callPeer=u;$("lv").srcObject=st;$("mu").textContent="Sesi kapat";$("cm").textContent="Kamerayı kapat";
  call=peer.call("nexo-"+u,st,{metadata:{video:v,name:me.name}});call.__out=true;
  callUI(true,nm,"Aranıyor…");bind(call,nm);
  ringT=setTimeout(function(){if(call&&!callOK){endCall();alert(nm+" cevap vermedi.")}},45000)
 }).catch(function(){endCall();alert("Arama başlatılamadı. Mikrofon/kamera iznini kontrol et.")})}
function incoming(c){
 var md=c.metadata||{},nm=String(md.name||c.peer.replace(/^nexo-/,"")).slice(0,40);
 if(call||!$("inc").classList.contains("hide")){c.close();return}
 $("ia").textContent=ini(nm);$("iname").textContent=nm;$("it").textContent=md.video?"Görüntülü arama":"Sesli arama";$("inc").classList.remove("hide");
 var t=setTimeout(hide,45000);
 function hide(){clearTimeout(t);$("inc").classList.add("hide")}
 c.on("close",hide);
 $("dec").onclick=function(){hide();c.close()};
 $("acc").onclick=function(){hide();media(!!md.video).then(function(st){lstream=st;callOK=false;call=c;$("lv").srcObject=st;$("mu").textContent="Sesi kapat";$("cm").textContent="Kamerayı kapat";c.answer(st);callUI(true,nm,"Bağlanıyor…");bind(c,nm)}).catch(function(){c.close();alert("Arama cevaplanamadı. Mikrofon/kamera iznini kontrol et.")})}}
$("en").onclick=endCall;
