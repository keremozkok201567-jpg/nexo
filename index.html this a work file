$("cm").onclick=function(){if(!lstream)return;var on=false;lstream.getVideoTracks().forEach(function(t){t.enabled=!t.enabled;on=t.enabled});$("cm").textContent=on?"Kamerayı kapat":"Kamerayı aç"};

